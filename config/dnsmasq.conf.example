# Copy to /etc/dnsmasq-pashani.conf and review for local conflicts.
interface=ap0
bind-interfaces
except-interface=lo
dhcp-range=192.168.50.20,192.168.50.200,255.255.255.0,12h
dhcp-option=option:router,192.168.50.1
dhcp-option=option:dns-server,192.168.50.1
# Uses the host's configured resolver path; this alone does not guarantee
# that DNS queries are routed through the VPN tunnel.
domain-needed
bogus-priv
